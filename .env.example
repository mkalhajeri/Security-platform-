# Copy this file to .env and adjust values for your environment.

# MongoDB connection string.
# Local dev example:   mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Name of the database used to store platform data.
DATABASE_NAME=security_platform

# Comma-separated list of origins allowed to call the API (for future UI).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth ---

# Signing key for login session tokens (JWT). MUST be overridden with a
# long random value in any shared/production deployment — generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-secret-change-me

# How long an access token (the one sent on every request) lasts before
# the client needs to use its refresh token to get a new one.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# How long the refresh token itself lasts before a full re-login is
# needed. POST /auth/logout-everywhere (or an admin/management-forced
# session revoke) invalidates both kinds immediately, regardless of this.
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bootstrap admin account, created automatically on first startup if no
# admin exists yet. Log in and change the password immediately — this
# default is not safe to leave as-is outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Administrator
